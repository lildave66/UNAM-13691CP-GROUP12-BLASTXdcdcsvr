{
  "expo": {
    "name": "BlastX",
    "slug": "BlastXApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/utils/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/utils/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blastx.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/utils/assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "blastx.app"
    },
    "web": {
      "favicon": "./src/utils/assets/images/icon.png",
      "bundler": "metro"
    },
    "scheme": "blastx-app",
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d9ee5591-5801-4436-8cba-ff95270e38a7"
      }
    }
  }
}
